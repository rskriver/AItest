                "name": "Hvide asparges med stenbiderrogn",
                "type": "Forret",
                "serves": 4,
                "ingredients": [
                    {
                        "label": null,
                        "items": [
                            "20 Hvide asparges",
                            "2 dl Cremefraiche",
                            "150 g Stenbiderrogn",
                            "En håndfuld Rugbrødschips",
                            "Et halvt bundt Dild",
                            "1 Citron",
                            "Salt",
                            "Peber"
                        ]
                    }
                ],
                "method": [
                    {
                        "label": null,
                        "steps": [
                            "Skræl de hvide asparges og knæk det allernederste stykke af.",
                            "Damp de hvide asparges i kogende letsaltet vand i ca. 3 – 4 minutter.",
                            "Anret de hvide asparges på en tallerken og pynt med cremefraiche og stenbiderrogn og dild.",
                            "Smag til med citronsaft, samt drys med rugbrødschips og salt og peber og serveres med flutes."
